# Required only for AI recipe generation and alteration.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Set to false to disable Google Search grounding for Gemini requests.
GEMINI_SEARCH_GROUNDING=true
# Optional: use a local mock Interactions endpoint during tests.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/interactions
DATABASE_URL=sqlite:/data/recipes.sqlite3
APP_BIND=0.0.0.0:3000
RUST_LOG=kindle_recipes=info,tower_http=info
