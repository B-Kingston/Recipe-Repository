# Optional overrides; every value shown is the default. AI logins (Codex,
# Claude, API keys) are added in Settings and stored in the database, never here.

# The Codex model new accounts start with.
# PI_MODEL=gpt-6-luna
# false turns off web search: in recipe generation, video imports, and the recipe chat.
# PI_SEARCH_ENABLED=true
# Sign-in limits count failures per client address. Set true only behind a
# reverse proxy that sets X-Forwarded-For itself: its left-most entry then
# counts as the client's address.
# TRUST_PROXY_HEADERS=false
# DATABASE_URL=sqlite:/data/recipes.sqlite3
# APP_BIND=0.0.0.0:3000
# RUST_LOG=kindle_recipes=info,tower_http=info

# Group invites are emailed through Resend when this key is set; without it,
# Settings shows the invite link for the inviter to send. Never logged or shown.
# RESEND_API_KEY=re_...
# RESEND_FROM=Recipe Repository <invites@mail.reciperepository.app>
# Invite links start with this address; unset, they use the inviter's Host over http.
# PUBLIC_BASE_URL=https://reciperepository.app

# The EmbeddingGemma 2 sidecar behind library search, video step moments, and
# dish-photo ranking. compose.yaml sets it; empty turns those features off.
# EMBEDDING_URL=http://embeddings:8080

# Video imports run yt-dlp, ffmpeg, faster-whisper, and PaddleOCR locally; the
# models download once into /data/media-models.
# MEDIA_WHISPER_MODEL=base
# translate renders non-English speech as English.
# MEDIA_WHISPER_TASK=transcribe
# false skips the dish-photo candidates of a video import.
# THUMBNAILS_ENABLED=true
# A yt-dlp cookies file for posts that need a login; never commit it.
# MEDIA_COOKIES_FILE=/run/secrets/social-cookies.txt
