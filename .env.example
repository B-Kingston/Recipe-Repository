# Pi authenticates a ChatGPT Plus/Pro subscription through the Settings page's
# Authorise Codex flow (and Claude via its Settings section); the OAuth credential is stored in the recipes database,
# so do not put ChatGPT credentials or OAuth tokens in this file.
PI_MODEL=gpt-6-luna
# Set to false to generate recipes without the provider's native web_search tool (OpenAI or Anthropic).
PI_SEARCH_ENABLED=true
# Optional local overrides for the Pi SDK worker and codex-auth/claude-auth helper paths.
# PI_WORKER_PATH=pi/recipe-worker.mjs
# PI_AUTH_SCRIPT_PATH=pi/codex-auth.mjs
# PI_CLAUDE_AUTH_SCRIPT_PATH=pi/claude-auth.mjs
# Agent dir for the Pi SDK's model cache; a legacy auth.json here is imported
# into the database once at startup.
# PI_CODING_AGENT_DIR=~/.pi/agent
DATABASE_URL=sqlite:/data/recipes.sqlite3
APP_BIND=0.0.0.0:3000
RUST_LOG=kindle_recipes=info,tower_http=info

# EmbeddingGemma 2 sidecar (compose service `embeddings`, llama.cpp). It powers
# library search, video step moments ("watch from 0:42" with frames), and the
# dish-photo ranking. compose.yaml points the app at http://embeddings:8080;
# set it empty to turn those features off, or to another llama-server URL.
# EMBEDDING_URL=http://embeddings:8080

# Social recipe-video importer. Docker installs these local tools by default:
# yt-dlp downloads public Facebook/Instagram media, ffmpeg extracts audio and
# frequent screenshots, faster-whisper transcribes audio locally, and the
# default PaddleOCR PP-OCRv6 reads screenshots in one batched process. The
# Whisper and PaddleOCR models are downloaded once into the persistent /data
# volume and are never sent to an AI API. Set these only for custom installs.
# MEDIA_YTDLP_PATH=yt-dlp
# MEDIA_FFMPEG_PATH=ffmpeg
# MEDIA_FFPROBE_PATH=ffprobe
# During a video import a local ffmpeg pass scores sampled frames and offers
# up to four cropped dish-photo candidates on the draft preview. Set to false
# to skip candidate extraction entirely.
# THUMBNAILS_ENABLED=true
# OCR is fixed to PP-OCRv6 small, the benchmarked production model.
# MEDIA_OCR_SCRIPT=pi/local-media.py
# MEDIA_OCR_LANG=en
# MEDIA_OCR_BATCH_SIZE=8
# MEDIA_OCR_SCORE_THRESHOLD=0.70
# MEDIA_OCR_DEVICE=cpu
# Text gate: a fast detection-only pass drops frames without any text before
# the full reader sees them. GATE_SIDE is the longer image side (px) it
# resizes to. Set MEDIA_OCR_TEXT_GATE=false to read every planned frame.
# MEDIA_OCR_TEXT_GATE=true
# MEDIA_OCR_GATE_SIDE=640
# OCR sampling: frames are cheaply extracted at SCAN_HZ and a steady grid of
# them is read at BASE_HZ. Every shot change on top of that grid is read too,
# since captions tend to appear with a cut. A shot change is a sample whose
# ffmpeg luma-change score (YDIF) is a local peak at least CUT_RATIO times the
# median score within one second around it, so it adapts to how shaky the
# footage is. Raise BASE_HZ if short caption cards on steady footage are
# missed (each extra Hz adds one OCR frame per second of video, about 0.3 s
# of CPU each); lower CUT_RATIO to read more cuts. MEDIA_OCR_ADAPTIVE=false
# reads the BASE_HZ grid only. At most 160 frames are read per video.
# MEDIA_OCR_ADAPTIVE=true
# MEDIA_OCR_SCAN_HZ=4
# MEDIA_OCR_BASE_HZ=1
# MEDIA_OCR_CUT_RATIO=2
# MEDIA_PYTHON=/opt/media-venv/bin/python
# MEDIA_TRANSCRIBE_SCRIPT=pi/local-media.py
# MEDIA_WHISPER_MODEL=base
# MEDIA_WHISPER_TASK=transcribe (or translate, to render non-English audio as English)
# MEDIA_WHISPER_COMPUTE_TYPE=int8
# Whisper decodes the speech chunks in batches of this many (beam size 1).
# MEDIA_WHISPER_BATCH_SIZE=8
# Whisper and PaddleOCR run in two long-lived helper processes (one per
# kind, started on the first import) so later imports skip the Python imports
# and the model loads. A helper exits after this many idle seconds and the next
# import starts a new one.
# MEDIA_WORKER_IDLE_SECONDS=600
# MEDIA_MODEL_CACHE=/data/media-models
# Video imports clean the raw caption/transcript/OCR down to recipe-only facts
# before the final recipe-generation model sees them. The cleaner's provider
# and model are chosen in Settings (default: the active AI provider).
# Optional for public posts that require a locally configured yt-dlp cookie
# strategy; do not commit cookie files or expose them through the UI.
# MEDIA_COOKIES_FILE=/run/secrets/social-cookies.txt
