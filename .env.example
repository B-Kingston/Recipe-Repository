# Pi authenticates a ChatGPT Plus/Pro subscription through the Settings page's
# Authorise Codex flow; the OAuth credential is stored in the recipes
# database, so do not put ChatGPT credentials or OAuth tokens in this file.
PI_MODEL=gpt-5.4-mini
# Set to false to generate recipes without OpenAI's native web_search tool.
PI_SEARCH_ENABLED=true
# Optional local overrides for the Pi SDK worker and codex-auth helper paths.
# PI_WORKER_PATH=pi/recipe-worker.mjs
# PI_AUTH_SCRIPT_PATH=pi/codex-auth.mjs
# Agent dir for the Pi SDK's model cache; a legacy auth.json here is imported
# into the database once at startup.
# PI_CODING_AGENT_DIR=~/.pi/agent
DATABASE_URL=sqlite:/data/recipes.sqlite3
APP_BIND=0.0.0.0:3000
RUST_LOG=kindle_recipes=info,tower_http=info
